cabal-version: 2.4
name: sdf-abstract-interpreter
version: 0.1.0.0
synopsis: Comparing two range analyses for a small procedural geometry language
description: A compact study of interval and Lipschitz range bounds, with tests and experiments.
author: Project contributors
maintainer: contributors@example.invalid
category: Language
build-type: Simple
extra-source-files: README.md docs/report.md scripts/reproduce.sh
                    cabal.project cabal.project.freeze

common defaults
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat
  build-depends: base >=4.17 && <5

library
  import: defaults
  hs-source-dirs: src
  exposed-modules: Syntax, Concrete, Interval, Abstract, Lipschitz, Spatial

executable sdf-analyse
  import: defaults
  hs-source-dirs: app, benchmarks
  main-is: Main.hs
  other-modules: Scenes
  build-depends: sdf-abstract-interpreter, deepseq >=1.4 && <1.6
  ghc-options: -rtsopts

test-suite properties
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Properties.hs
  build-depends: sdf-abstract-interpreter, QuickCheck >=2.14 && <2.16
